---
import HeadMeta from "../components/HeadMeta.astro";
import YaMetrika from "../components/third-party-script/YaMetrika.astro";
import { ClientRouter } from "astro:transitions";
import { global, localeFromPath } from "../lib/config";
import "../styles/index.css";

const locale = localeFromPath(Astro.url.pathname);
---

<html class="page" lang={global(locale).language}>
	<head>
		<HeadMeta />
		<ClientRouter />
		<script is:inline>
			(() => {
				const applySavedTheme = () => {
					const savedTheme = localStorage.getItem("theme");
					document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";
				};

				applySavedTheme();
				document.addEventListener("astro:after-swap", applySavedTheme);
			})();
		</script>

		<link
			rel="preload"
			href="/fonts/SuisseIntl.woff2"
			crossorigin
			as="font"
			type="font/woff2"
		/>
		<link
			rel="preload"
			href="/fonts/SuisseIntlBold.woff2"
			crossorigin
			as="font"
			type="font/woff2"
		/>

		<slot name="head" />
	</head>
	<body class="page__body">
		<slot />

		<style is:global>
			.page {
				background-color: var(--body-color);
				color: var(--text-color);
			}

			.page__body {
				margin: 0;
				line-height: 1;
				font-weight: 400;
				font-size: var(--font-size-normal);
			}

			.column {
				@media (width > 1024px) {
					padding-inline: 40px;
				}
				@media (width < 1024px) {
					padding-inline: 20px;
				}
			}

			.divider {
				margin: 20px 0;
				width: 100%;
				border-top: 2px solid var(--border-color);
			}

			.divider.is-white {
				border-top: 2px solid var(--white);
			}
		</style>

		<script>
			import Lenis from "lenis";
			import "lenis/dist/lenis.css";

			const scrollEasing = (progress) => 1 - Math.pow(1 - progress, 3);
			let lenis;

			if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
				lenis = new Lenis({
					autoRaf: true,
					anchors: {
						duration: 1.8,
						easing: scrollEasing,
					},
				});
			}

			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element)) return;
				const link = event.target.closest(".go-to-top-link");
				if (!(link instanceof HTMLAnchorElement) || !lenis) return;

				event.preventDefault();
				lenis.scrollTo("#header", { duration: 1.8, easing: scrollEasing });
			}, true);
		</script>

		<YaMetrika />
	</body>
</html>
