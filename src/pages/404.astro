---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/home/Photo.astro";
import { global } from "../lib/config";
---

<BaseLayout>
	<slot slot="head">
		<title>{global().title} | 404</title>
	</slot>
	<main class="main column">
		<Header />
		<Photo src="/404-img@2x.webp" hoverSrc="/404-img-alt@2x.webp" alt="404 illustration" />

		<h1>404 err or — Page Not Found</h1>

		<h1>¯\_(ツ)_/¯</h1>

		<p>
			Unfortunately, the requested page was not found. Either it doesn't
			exist or it has been removed.
		</p>

		<p><a href="/">Go back to the home page</a></p>
	</main>
	<Footer />
</BaseLayout>

<style>
	p {
		margin-bottom: 160px;
	}

	a {
		color: var(--primary);
	}
</style>
