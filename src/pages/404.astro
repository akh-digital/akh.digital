---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/home/Photo.astro";
import { global, localeFromPath } from "../lib/config";

const locale = localeFromPath(Astro.url.pathname);
---

<BaseLayout>
	<slot slot="head">
		<title>{global(locale).title} | 404</title>
	</slot>
	<main class="main column">
		<Header />
		<Photo src="/404-img@2x.webp" hoverSrc="/404-img-alt@2x.webp" alt="404 illustration" />

		<h1>404 err or — Page Not Found</h1>

		<h1>¯\_(ツ)_/¯</h1>

		<p>
			Unfortunately, the requested page was not found. Either it doesn't
			exist or it has been removed.
		</p>

		<p><a href="/">Go back to the home page</a></p>
	</main>
	<Footer />
</BaseLayout>

<script>
	const languageSwitch = document.querySelector("a[data-language-switch]");

	if (languageSwitch instanceof HTMLAnchorElement) {
		const isRussianPath =
			window.location.pathname === "/ru" || window.location.pathname.startsWith("/ru/");

		languageSwitch.href = isRussianPath ? "/" : "/ru";
		languageSwitch.textContent = isRussianPath ? "(EN)" : "(RU)";
		languageSwitch.setAttribute(
			"aria-label",
			isRussianPath ? "Switch to English" : "Switch to Russian",
		);
	}
</script>

<style>
	p {
		margin-bottom: 160px;
	}

	a {
		color: var(--primary);
	}
</style>
