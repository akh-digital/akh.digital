---
import { getCollection } from "astro:content";
import Show from "../../lib/Show.astro";

const { slug } = Astro.params;

const projects = await getCollection("projects");
const currentProject = projects.find((project) => project.slug === slug);
const data = currentProject?.data ?? {};
const { date, tags = [], web, client, role, responsibilities } = data;
const responsibilitiesList = Array.isArray(responsibilities)
	? responsibilities
	: responsibilities
		? responsibilities
				.split(",")
				.map((item) => item.trim())
				.filter(Boolean)
		: [];
---

<section class="meta-data">
	<div class="item-wrapper">
		<div class="item">
			<div class="item-title">Year:</div>
			<div>{new Date(date).getFullYear()}</div>
		</div>
		<Show when={client}>
			<div class="item">
				<div class="item-title">Client:</div>
				<div>{client}</div>
			</div>
		</Show>
		<Show when={role}>
			<div class="item">
				<div class="item-title">Role:</div>
				<div>{role}</div>
			</div>
		</Show>
		<div class="item">
			<div class="item-title">Tags:</div>
			<ul class="tags">
				{tags.map((tag) => <li class="tag">{tag}</li>)}
			</ul>
		</div>
	</div>
	<div class="item-wrapper">
		<Show when={web}>
			<div class="item">
				<div class="item-title">Web:</div>
				<a target="_blank" href={`https://${web}`}>
					{web}
				</a>
			</div>
		</Show>
		<Show when={responsibilitiesList.length > 0}>
			<div class="item">
				<div class="item-title">Responsibilities:</div>
				<ul class="responsibilities">
					{responsibilitiesList.map((item) => <li>{item}</li>)}
				</ul>
			</div>
		</Show>
	</div>
</section>

<style>
	.meta-data {
		display: grid;
		gap: 20px;
		margin-top: 60px;
		margin-bottom: 60px;

		@media (width < 1024px) {
			margin-bottom: 40px;
		}
	}

	.item-wrapper {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 80px;

		@media (width < 1024px) {
			gap: 20px;
		}

		.item {
			display: flex;
			flex-wrap: nowrap;
			align-items: flex-start;
			gap: 24px;
			font-size: var(--font-size-normal);

			@media (width < 1024px) {
				flex-direction: column;
				gap: 20px;
			}

			.item-title {
				flex: 0 0 120px;
			}

			a {
				color: var(--black);
				text-decoration: none;
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
				margin: 0;
				padding: 0;

				list-style: none;
				font-size: var(--font-size-extra-small);

				.tag {
					display: flex;
					flex-wrap: wrap;
					padding: 8px 16px;
					border: 1px solid var(--black);
					border-radius: 0px;
					color: var(--black);
					list-style: none;
					text-decoration: none;
					font-size: 14px;
				}
			}

			.responsibilities {
				display: flex;
				flex-direction: column;
				gap: 8px;
				margin: 0;
				padding: 0;
				list-style: none;
				font-size: var(--font-size-normal);
			}
		}
	}
</style>
