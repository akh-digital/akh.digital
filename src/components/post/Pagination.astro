---
import { getCollection } from "astro:content";
import Show from "../../lib/Show.astro";
import Icon from "../Icon.astro";
import { localeFromPath } from "../../lib/config.js";
const { slug } = Astro.params;
const locale = localeFromPath(Astro.url.pathname);
const prefix = locale === "ru" ? "/ru" : "";

const projects = (await getCollection("projects")).filter((project) =>
	locale === "ru" ? project.id.endsWith("index.ru.md") : project.id.endsWith("index.md"),
);
const sortedProjects = projects.sort((a, b) => {
	return b.data.date - a.data.date;
});
const getProjectSlug = (project) =>
	locale === "ru" ? project.id.split("/").slice(-2, -1)[0].toLowerCase() : project.slug;
const currentProjectIndex = sortedProjects.findIndex(
	(project) => getProjectSlug(project) === slug,
);
const prevPage = sortedProjects[currentProjectIndex - 1]
	? getProjectSlug(sortedProjects[currentProjectIndex - 1])
	: undefined;
const nextPage = sortedProjects[currentProjectIndex + 1]
	? getProjectSlug(sortedProjects[currentProjectIndex + 1])
	: undefined;
---

<section class="pagination">
	<div class="wrapper">
		<div class="divider"></div>
		<div class="list">
			<Show when={prevPage}>
				<div class="item">
					<Icon size="33" name="arrow-left" />
					<a href={`${prefix}/projects/${prevPage}`}> {locale === "ru" ? "ПРЕДЫДУЩИЙ ПРОЕКТ" : "PREVIOUS PROJECT"} </a>
				</div>
			</Show>

			<Show when={nextPage}>
				<div class="item">
					<a href={`${prefix}/projects/${nextPage}`}> {locale === "ru" ? "СЛЕДУЮЩИЙ ПРОЕКТ" : "NEXT PROJECT"} </a>
					<Icon size="33" name="arrow-right" />
				</div>
			</Show>
		</div>
		<div class="divider"></div>
	</div>
</section>

<style>
	.list {
		place-content: center;
		display: flex;
		gap: 40px;

		@media (width < 1024px) {
			flex-wrap: wrap;
			gap: 10px;
			font-size: 2rem;

			@media (max-width: 600px) {
				font-size: 0.8rem;
			}
		}

		.item {
			position: relative;
			display: inline-flex;
			align-items: center;
			gap: 24px;
			padding: 10px 0;
			a {
				color: var(--black);
				text-decoration: none;

				&::before {
					content: "";
					position: absolute;
					inset: 0;
				}
			}
		}
	}
</style>
