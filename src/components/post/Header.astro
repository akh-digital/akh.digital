---
import { getCollection } from "astro:content";
import { localeFromPath, projectTranslation } from "../../lib/config.js";

const { slug } = Astro.params;
const locale = localeFromPath(Astro.url.pathname);

const projects = (await getCollection("projects")).filter((project) =>
	locale === "ru" ? project.id.endsWith("index.ru.md") : project.id.endsWith("index.md"),
);
const sortedProjects = projects.sort((a, b) => {
	return b.data.date - a.data.date;
});
const getProjectSlug = (project) =>
	locale === "ru" ? project.id.split("/").slice(-2, -1)[0].toLowerCase() : project.slug;
const currentProjectNumber =
	sortedProjects.findIndex((project) => getProjectSlug(project) === slug) + 1;

const currentProject = projects.find((project) =>
	locale === "ru"
		? project.id.split("/").slice(-2, -1)[0].toLowerCase() === slug
		: project.slug === slug,
);
const { title } = { ...currentProject.data, ...(projectTranslation(slug, locale) ?? {}) };
---

<section class="post-header">
	<div class="post-header__divider"></div>
	<div class="post-header__wrapper">
		<div class="post-header__number">
			<span class="post-header__number__first">
				{String(currentProjectNumber).padStart(2, "0")}
			</span>
			/
			<span>
				{String(projects.length).padStart(2, "0")}
			</span>
		</div>
		<div class="post-header__title">
			{title}
		</div>
	</div>
	<div class="post-header__divider"></div>
</section>

<style>
	.post-header__divider {
		margin: 20px 0;
		border-top: 2px solid var(--black);
	}
	.post-header__number {
		font-weight: 500;
		font-size: 1.2rem;

		@media (max-width: 600px) {
			font-size: 2rem;
		}
	}
	.post-header__number__first {
		color: var(--primary);
	}
	.post-header__title {
		word-break: break-all;
		display: inline-block;
		margin-top: 60px;
		margin-bottom: 10px;
		font-weight: 500;
		font-size: var(--font-size-h1);
	}
</style>
