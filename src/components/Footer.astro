---
import Icon from "./Icon.astro";
import { localeFromPath } from "../lib/config.js";

const locale = localeFromPath(Astro.url.pathname);
const copy = locale === "ru"
	? { rights: "НЕКОТОРЫЕ ПРАВА СОХРАНЕНЫ", developed: "Разработал", website: "сайт", marquee: "ДЕЛАЮ ПИКСЕЛИ ВЕЛИКИМИ СНОВА" }
	: { rights: "SOME RIGHTS RESERVED", developed: "Developed by", website: "website" };
---

<footer class="footer column">
	<div class="footer__info">
		<span>ALEKS KHOLOPOV © 2022-2026</span>
		<Icon name="logo" size="52" />
		<span>{copy.rights}</span>
	</div>
	<div class="divider is-white"></div>
	<div class="footer__marquee" aria-label={locale === "ru" ? "ДЕЛАЮ ПИКСЕЛИ ВЕЛИКИМИ СНОВА" : "MAKING PIXELS GREAT AGAIN"}>
		<div class="footer__marquee-track">
			<span class="footer__big-title">{copy.marquee ?? "MAKING PIXELS GREAT AGAIN"}</span>
			<span class="footer__big-title" aria-hidden="true">{copy.marquee ?? "MAKING PIXELS GREAT AGAIN"}</span>
			<span class="footer__big-title" aria-hidden="true">{copy.marquee ?? "MAKING PIXELS GREAT AGAIN"}</span>
			<span class="footer__big-title" aria-hidden="true">{copy.marquee ?? "MAKING PIXELS GREAT AGAIN"}</span>
			<span class="footer__big-title" aria-hidden="true">{copy.marquee ?? "MAKING PIXELS GREAT AGAIN"}</span>
			<span class="footer__big-title" aria-hidden="true">{copy.marquee ?? "MAKING PIXELS GREAT AGAIN"}</span>
		</div>
	</div>
	<div class="footer__project-author">
		{copy.developed}
		<a href="https://www.linkedin.com/in/velopsey/">
			Daniil Savitskii
		</a>
		<br />
		<span style="display: inline-block; margin-top: 24px;">{copy.website} — <a href={locale === "ru" ? "/ru" : "/"}>akh</a> — 072026 — v2.6 — rm</span>
	</div>
</footer>

<style>
	.footer {
		padding-top: 40px;
		background: var(--black);
		color: var(--white);
		font-size: 0.8rem;

		@media (max-width: 600px) {
			font-size: 0.5rem;
		}
	}

	.footer__info {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		justify-items: center;
		align-items: center;

		:first-child {
			justify-self: left;
		}

		:last-child {
			justify-self: right;
			text-align: right;
		}
	}

	.footer__info-credentials {
		display: flex;
		justify-self: end;
		align-self: center;
		gap: 28px;
		width: min-content;
	}

	.footer__marquee {
		overflow: hidden;
		margin-top: 40px;
		margin-bottom: 40px;
		width: 100%;
	}

	.footer__marquee-track {
		display: inline-flex;
		align-items: center;
		width: max-content;
		will-change: transform;
		animation: footer-marquee 8s linear infinite;
	}

	.footer__big-title {
		display: inline-block;
		white-space: nowrap;
		text-align: left;
		line-height: 110%;
		font-weight: bold;
		font-size: var(--font-size-footer-name);
		padding-right: 0.4em;
		flex-shrink: 0;
	}

	@keyframes footer-marquee {
		from {
			transform: translate3d(0, 0, 0);
		}

		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	.footer__project-author {
		padding-bottom: 40px;
		text-align: center;
		font-size: 0.8rem;

		@media (max-width: 600px) {
			font-size: 0.5rem;
		}

		a {
			color: var(--primary);
		}
	}
</style>
