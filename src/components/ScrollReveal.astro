<script>
const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

document.documentElement.classList.add('scroll-reveal-ready');

const createSplitText = (element) => {
	if (element.dataset.revealSplitDone === 'true' || element.children.length > 0) {
		return;
	}

	const originalText = element.textContent?.trim() ?? '';
	if (!originalText) {
		return;
	}

	const pieces = originalText.split(/(\s+)/);
	const fragment = document.createDocumentFragment();

	pieces.forEach((piece, index) => {
		if (!piece.trim()) {
			fragment.appendChild(document.createTextNode(piece));
			return;
		}

		const word = document.createElement('span');
		word.className = 'scroll-reveal__word';
		const inner = document.createElement('span');
		inner.textContent = piece;
		inner.style.transitionDelay = `${index * 45}ms`;
		word.appendChild(inner);
		fragment.appendChild(word);
	});

	element.textContent = '';
	element.appendChild(fragment);
	element.dataset.revealSplitDone = 'true';
};

const revealTargets = () => {
	const observer = new IntersectionObserver(
		(entries, obs) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) {
					return;
				}

				const target = entry.target;
				if (target.matches('[data-reveal-text]')) {
					createSplitText(target);
				}

				target.classList.add('is-visible');
				obs.unobserve(target);
			});
		},
		{
			threshold: 0.18,
			rootMargin: '0px 0px -6% 0px',
		},
	);

	document.querySelectorAll('[data-reveal], [data-reveal-text]').forEach((target) => {
		if (prefersReducedMotion.matches) {
			target.classList.add('is-visible');
			if (target.matches('[data-reveal-text]')) {
				createSplitText(target);
			}
			return;
		}

		observer.observe(target);
	});
};

const init = () => {
	if (prefersReducedMotion.matches) {
		document.querySelectorAll('[data-reveal], [data-reveal-text]').forEach((target) => {
			target.classList.add('is-visible');
			if (target.matches('[data-reveal-text]')) {
				createSplitText(target);
			}
		});
		return;
	}

	revealTargets();
};

if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', init, { once: true });
} else {
	init();
}
</script>

<style is:global>
html.scroll-reveal-ready [data-reveal],
html.scroll-reveal-ready [data-reveal-text] {
	opacity: 0;
	transform: translateY(24px);
	transition:
		opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
		transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
}

html.scroll-reveal-ready [data-reveal].is-visible,
html.scroll-reveal-ready [data-reveal-text].is-visible {
	opacity: 1;
	transform: translateY(0);
}

.scroll-reveal__word {
	display: inline-block;
	overflow: hidden;
	vertical-align: top;
}

.scroll-reveal__word > span {
	display: inline-block;
	opacity: 0;
	transform: translateY(120%);
	transition:
		opacity 0.75s cubic-bezier(0.2, 0.7, 0.2, 1),
		transform 0.75s cubic-bezier(0.2, 0.7, 0.2, 1);
}

[data-reveal-text].is-visible .scroll-reveal__word > span {
	opacity: 1;
	transform: translateY(0);
}
</style>
