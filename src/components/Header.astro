---
import Icon from "./Icon.astro";
import { localeFromPath, localizedPath } from "../lib/config.js";

const locale = localeFromPath(Astro.url.pathname);
const alternateLocale = locale === "ru" ? "en" : "ru";
const alternateLabel = locale === "ru" ? "EN" : "RU";
const alternatePath = localizedPath(Astro.url.pathname, alternateLocale);
---

<header id="header" class="header">
	<nav class="navigation">
		<div class="navigation__list">
			<a class="navigation__link" href={locale === "ru" ? "/ru" : "/"}>{locale === "ru" ? "(Главная)" : "(Home)"}</a>
			<a class="navigation__logo" href={locale === "ru" ? "/ru" : "/"}>
				<Icon name="logo" size="52" />
			</a>
			<a class="navigation__link" href={locale === "ru" ? "/ru/about" : "/about"}>{locale === "ru" ? "(Обо мне)" : "(About)"}</a>
			<a class="navigation__language" href={alternatePath} aria-label={`Switch to ${alternateLabel}`}>{alternateLabel}</a>
		</div>
	</nav>
</header>

<style>
	.header {
		padding: 16px 0 10px;
	}

	.navigation__list {
		display: grid;
		grid-template-columns: 1fr auto 1fr auto;
		justify-items: center;
		align-items: center;
		margin: 0;
		padding: 0;

		:first-child {
			justify-self: start;
		}

		:nth-child(3) {
			justify-self: end;
		}

		:last-child {
			justify-self: end;
			margin-left: 20px;
		}
	}

	.navigation__link {
		position: relative;
		color: var(--black);
		text-transform: uppercase;
		text-decoration: none;
		font-size: var(--font-size-normal);

		&:hover:after {
			content: "";
			position: absolute;
			right: 0;
			bottom: -2px;
			width: 100%;
			height: 2px;
			background: var(--black);
		}
	}

	.navigation__logo {
		display: block;
		border-radius: 50%;
		color: var(--logo-color);
		line-height: 0.5;
	}

	.navigation__language {
		color: var(--black);
		font-size: var(--font-size-extra-small);
		text-decoration: none;
	}
</style>
