---
import { about, localeFromPath, project } from "../../lib/config.js";
import { parseDescription } from "../../lib/parseDescription.js";

const locale = localeFromPath(Astro.url.pathname);
const expertiseData = project(locale).expertise;
const aboutData = about(locale);

const tags = expertiseData.tags;
const descList = parseDescription(expertiseData.desc);
const findSocialUrl = (title) => {
	const socialLink = aboutData.social.list.find((link) => link.title === title);
	if (!socialLink) {
		throw new Error(`Missing ${title} contact link`);
	}
	return socialLink.url;
};
const cvTitle = locale === "ru" ? "PDF / RUSSIAN" : "PDF / ENGLISH";
const cv = aboutData.cv.list.find((item) => item.title === cvTitle);
if (!cv) {
	throw new Error(`Missing ${locale} CV link`);
}
const contactLinks = new Map(
	locale === "ru"
		? [
				["LinkedIn", findSocialUrl("linkedin")],
				["Telegram", findSocialUrl("telegram")],
				["почту", findSocialUrl("aleks@akh-digital.ru")],
				["CV", cv.url],
			]
		: [
				["LinkedIn", findSocialUrl("linkedin")],
				["Telegram", findSocialUrl("telegram")],
				["email", findSocialUrl("aleks@akh-digital.ru")],
				["CV", cv.url],
			],
);
---

<section class="tags">
	<div class="tags__wrapper">
		<div class="tags__title-wrapper">
			<h2 class="tags__title" lang={locale}>
				{expertiseData.title}
			</h2>
		</div>
		<ul class="tags__list">
			{tags
				.filter((tag) => !("icon" in tag))
				.map((tag) => <li class="tags__list_item">{tag.text}</li>)}
		</ul>
	</div>
	<div class="tags__desc">
		{descList.map((d) => (
			<p>
				{d.split(locale === "ru" ? /(LinkedIn|Telegram|почту|CV)/g : /(LinkedIn|Telegram|email|CV)/g).map((part) => {
					const url = contactLinks.get(part);
					return url ? (
						<a href={url} target="_blank" rel="noopener noreferrer">{part}</a>
					) : (
						part
					);
				})}
			</p>
		))}
	</div>
</section>

<style>
	.tags {
		margin-bottom: 100px;
	}
	.tags__title {
		color: var(--primary);
		max-width: 100%;
		text-align: center;
		font-weight: 400;
		font-size: var(--font-size-h1);
		hyphens: auto;
	}

	.tags__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0 0;

		margin: 0;
		padding: 0;

		list-style: none;
		font-size: var(--font-size-normal);
	}

	.tags__list_item {
		display: flex;
		padding: 0.5em 0.9em;
		background-color: var(--black);
		border-radius: 999px;
		line-height: 1.2;
		letter-spacing: 0.01em;
		color: var(--body-color);
	}

	.tags__desc {
		word-break: normal;
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		text-wrap: balance;
		margin-top: 60px;
		text-align: justify;
		text-indent: 80px;
	}

	.tags__desc > p {
		margin: 0;
	}

	.tags__desc a {
		color: inherit;
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.tags__desc {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
