---
import { localeFromPath, project } from "../../lib/config.js";
import { parseDescription } from "../../lib/parseDescription.js";

const expertiseData = project(localeFromPath(Astro.url.pathname)).expertise;

const tags = expertiseData.tags;
const descList = parseDescription(expertiseData.desc);
---

<section class="tags">
	<div class="tags__wrapper">
		<div class="tags__title-wrapper">
			<h2 class="tags__title">
				{expertiseData.title}
			</h2>
		</div>
		<ul class="tags__list">
			{tags
				.filter((tag) => !("icon" in tag))
				.map((tag) => <li class="tags__list_item">{tag.text}</li>)}
		</ul>
	</div>
	<div class="tags__desc">
		{descList.map((d) => <p>{d}</p>)}
	</div>
</section>

<style>
	.tags {
		margin-bottom: 100px;
	}
	.tags__title {
		color: var(--primary);
		max-width: 100%;
		text-align: center;
		font-weight: 400;
		font-size: var(--font-size-h1);
		overflow-wrap: anywhere;
	}

	.tags__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 10px 12px;

		margin: 0;
		padding: 0;

		list-style: none;
		font-size: var(--font-size-normal);
	}

	.tags__list_item {
		display: flex;
		padding: 0.5em 0.9em;
		border: 1px solid var(--border-color);
		border-radius: 999px;
		line-height: 1.2;
		letter-spacing: 0.01em;
		color: var(--text-color);
	}

	.tags__desc {
		word-break: normal;
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		text-wrap: balance;
		margin-top: 60px;
		text-align: justify;
		text-indent: 80px;
	}

	.tags__desc > p {
		margin: 0;
	}

	@media (min-width: 768px) {
		.tags__desc {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
