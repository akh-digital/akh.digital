---
import Icon from "../Icon.astro";
import { project } from "../../lib/config.js";
import { parseDescription } from "../../lib/parseDescription.js";

const expertiseData = project().expertise;

const tags = expertiseData.tags;
const descList = parseDescription(expertiseData.desc);
---

<section class="tags">
	<div class="tags__wrapper">
		<div class="tags__title-wrapper">
			<h2 class="tags__title">
				{expertiseData.title}
			</h2>
		</div>
		<ul class="tags__list">
			{
				tags.map((tag) => {
					if (!("icon" in tag)) {
						return <li class="tags__list_item">{tag.text}</li>;
					}

					const defaultIcon = tag.icon.endsWith("-a") ? tag.icon.replace(/-a$/, "") : tag.icon;
					const animatedIcon =
						tag.icon === "a1" || tag.icon === "a1-a"
							? "a1_a"
							: tag.icon.endsWith("-a")
								? tag.icon
								: `${defaultIcon}-a`;

					return (
						<span class="tag__icon-wrapper">
							<Icon class="tag__icon tag__icon--default" name={defaultIcon} />
							<Icon class="tag__icon tag__icon--animated" name={animatedIcon} />
						</span>
					);
				})
			}
		</ul>
	</div>
	<div class="tags__desc">
		{descList.map((d) => <p>{d}</p>)}
	</div>
</section>

<style>
	.tags {
		margin-bottom: 100px;
	}
	.tags__title {
		color: var(--primary);
		text-align: center;
		font-weight: 400;
		font-size: var(--font-size-h1);
	}

	.tags__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;

		row-gap: calc(var(--font-size-normal) / 2);
		column-gap: calc(var(--font-size-normal) / 2);

		margin: 0;
		padding: 0;

		list-style: none;
		font-size: var(--font-size-normal);
	}

	.tags__list_item {
		
		display: flex;
		padding: calc(var(--font-size-normal) / 2)
			calc(var(--font-size-normal) * 1.5);

		border: 2px solid var(--black);
		border-radius: calc(var(--font-size-normal) * 0);

		color: var(--black);
	}

	.tag__icon-wrapper {
		position: relative;
		display: block;
		width: calc(var(--font-size-normal) * 2);
		height: calc(var(--font-size-normal) * 2);
	}

	:global(.tag__icon) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		transition: opacity 200ms ease;
	}

	:global(.tag__icon--animated) {
		opacity: 0;
		pointer-events: none;
	}

	.tag__icon-wrapper:hover :global(.tag__icon--default) {
		opacity: 0;
	}

	.tag__icon-wrapper:hover :global(.tag__icon--animated) {
		opacity: 1;
	}

	.tags__desc {
		word-break: normal;
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		text-wrap: balance;
		margin-top: 60px;
		text-align: justify;
		text-indent: 80px;
	}

	.tags__desc > p {
		margin: 0;
	}

	@media (min-width: 768px) {
		.tags__desc {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
