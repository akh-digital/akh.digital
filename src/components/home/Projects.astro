---
import { getCollection } from "astro:content";
import Project from "./Project.astro";
import { localeFromPath, project as projectConfig } from "../../lib/config.js";
const locale = localeFromPath(Astro.url.pathname);
const prefix = locale === "ru" ? "/ru" : "";
const projects = (await getCollection("projects")).filter((project) =>
	locale === "ru" ? project.id.endsWith("index.ru.md") : project.id.endsWith("index.md"),
);
const projectPreviews = import.meta.glob(
	"../../content/projects/*/preview.webp",
	{ eager: true, query: "?url", import: "default" },
);
const sortedProjects = projects.sort((a, b) => {
	return b.data.date - a.data.date;
});
const getProjectSlug = (project) =>
	locale === "ru" ? project.id.split("/").slice(-2, -1)[0].toLowerCase() : project.slug;
const getProjectPreview = (project) => {
	const projectDirectory = project.id.split("/")[0];
	return Object.entries(projectPreviews).find(([path]) =>
		path.includes(`/${projectDirectory}/`),
	)?.[1];
};
---

<section class="projects">
	<div class="projects__wrapper">
		<div class="projects__title-wrapper">
			<h1 class="projects__big-title">
				{projectConfig(locale).projects.title} ({projects.length})
			</h1>
		</div>
		<div class="projects__list">
			{
				sortedProjects.map((project, index) => (
					<Project
							slug={prefix + "/projects/" + getProjectSlug(project)}
						number={String(index + 1).padStart(2, "0")}
							project={project.data}
							preview={getProjectPreview(project)}
					/>
				))
			}
		</div>
	</div>
</section>

<style>
	.projects {
		margin-bottom: 0px;
	}
	.projects__big-title {
		color: var(--primary);
		text-align: center;
		font-weight: 400;
		font-size: var(--font-size-h1);
	}

	.projects__list {
		display: flex;
		flex-direction: column;
		row-gap: 40px;
	}
</style>
