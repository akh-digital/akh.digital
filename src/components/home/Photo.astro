---
const { src = "/aleks-main@2x.webp", hoverSrc, alt = "Aleks" } = Astro.props;
---

<section class="photo">
	<div class="photo-container">
		<div class="gradient-1"></div>
		<div class="gradient-2"></div>
		<img src={src} alt={alt} class="image image--default" />
		{hoverSrc && <img src={hoverSrc} alt={`${alt} hover`} class="image image--hover" />}
	</div>
</section>

<style>
	.photo {
		place-content: center;
		display: grid;
		margin: 100px 0 100px;
	}
	.photo-container {
		position: relative;
	}
	.image {
		width: 400px;
		height: auto;
		border-radius: 0px;
		transition: opacity 420ms cubic-bezier(0.22, 1, 0.36, 1), transform 420ms cubic-bezier(0.22, 1, 0.36, 1);

		@media (width >= 1760px) {
			width: 600px;
		}
		@media (1024px <= width < 1760px) {
			width: 600px;
		}
	}

	.image--hover {
		position: absolute;
		inset: 0;
		opacity: 0;
		pointer-events: none;
		transform: scale(0.98);
	}

	.photo-container:hover .image--default {
		opacity: 0;
		transform: scale(0.98);
	}

	.photo-container:hover .image--hover {
		opacity: 1;
		transform: scale(1);
	}
</style>
