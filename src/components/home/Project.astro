---
import Icon from "../Icon.astro";
const { project, number, slug, preview } = Astro.props;
const tags = project.tags;
---

<article class="project">
	<header class="project_header">
		<span class="project_header_number">
			{number} /
		</span>
		<span class="project_header_date">
			{new Date(project.date).getFullYear()}
		</span>
	</header>
	{preview && <img class="project__preview" src={preview} alt="" aria-hidden="true" loading="lazy" />}
	<h3 class="projects__title">
		<a class="projects__link" href={slug}>
			{project.title}
		</a>
		<Icon size="32px" name="arrow-right" />
	</h3>
	<div class="projects_tag_list">
		{tags.map((tag) => <span class="projects__tag"> {tag} </span>)}
	</div>
</article>

<style>
	.project {
		position: relative;
	}
	.project__preview {
		position: absolute;
		z-index: 1;
		top: 50%;
		right: 12%;
		width: min(34vw, 360px);
		aspect-ratio: 16 / 10;
		object-fit: cover;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-44%) rotate(3deg) scale(0.78);
		transition:
			opacity 260ms ease,
			transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.project:hover .project__preview,
	.project:focus-within .project__preview {
		opacity: 1;
		transform: translateY(-50%) rotate(-2deg) scale(1);
	}

	@media (width < 768px) {
		.project__preview {
			display: none;
		}
	}

	.project_header {
		display: flex;
		justify-content: space-between;
		padding-bottom: 10px;
		border-bottom: 2px solid var(--black);
	}

	.projects__title {
		word-break: break-all;
		display: flex;
		justify-content: space-between;
		align-items: center;

		svg {
			flex-shrink: 0;
			width: var(--font-size-h2);
			height: var(--font-size-h2);
		}
	}

	.projects__link {
		color: var(--black);
		text-decoration: none;
		font-weight: 500;
		font-size: var(--font-size-h1);

		&::before {
			content: "";
			position: absolute;
			inset: 0;
		}

		&:focus-visible {
			outline: none;
		}

		&:focus-visible::before {
			outline: 2px solid var(--color-focus-ring);
			outline-offset: 2px;
		}
	}

	.projects_tag_list {
		display: flex;
		flex-wrap: wrap;
		gap: calc(var(--font-size-extra-small) / 2);
	}

	.projects__tag {
		padding: calc(var(--font-size-extra-small) / 2)
			calc(var(--font-size-extra-small));
		border: 1px solid var(--black);
		border-radius: calc(var(--font-size-small) * 0);
		font-size: var(--font-size-extra-small);
	}
</style>
