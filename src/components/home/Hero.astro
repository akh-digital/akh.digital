---
import { localeFromPath } from "../../lib/config.js";

const locale = localeFromPath(Astro.url.pathname);
const title = locale === "ru"
	? "Ведущий продуктовый дизайнер, специализируюсь на B2B и сложных корпоративных системах"
	: "Lead Product Designer specializing in B2B and complex enterprise systems";
---

<div class="divider"></div>

<div class="intro__wrapper">
	<p class="intro__site-name">Aleks Kholopov</p>
	<h1 class="intro__name intro__additional-name">{title}</h1>
</div>

<div class="divider"></div>

<style>
	.intro__wrapper {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding-top: 20px;
		padding-bottom: 20px;
	}

	.intro__site-name {
		position: relative;
		margin: 0;
		width: 100%;
		text-align: center;
		text-align-last: center;
		font-weight: bold;
		font-size: 3rem;

		@media (max-width: 600px) {
			font-size: 2rem;
		}
	}

	.intro__name {
		margin: 12px 0 0;
		width: 100%;
		text-align: center;
		overflow-wrap: anywhere;
		font-weight: normal;
		font-size: var(--font-size-extra-small);
		line-height: 110%;
		text-transform: uppercase;

		@media (max-width: 600px) {
			font-size: var(--font-size-extra-small);
		}
	}
</style>
