---
import { about } from "../../lib/config.js";
import { parseDescription } from "../../lib/parseDescription.js";
import Icon from "../Icon.astro";

const aboutData = about().about;
const descList = parseDescription(aboutData.desc);
---

<section class="about">
	<div class="wrapper">
		<div class="about__about-me_text">
			<h2>
				{aboutData.title}
			</h2>
			<Icon size="32" name="arrow-right" />
			{descList.map((d) => <p>{d}</p>)}
		</div>
		<div class="avatar-wrapper">
			<img src="/aleks-about@2x.webp" alt="Aleks" class="avatar" />
		</div>
	</div>
</section>

<style>
	.wrapper {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(186px, 1fr));
		justify-items: center;
		align-items: top;
	gap: 24px;
		margin-top: 60px;

		@media (max-width: 600px) {
			grid-template-columns: repeat(1, 1fr);
			margin-top: 60px;
			gap: 40px;
		}
	}
	.avatar {
		width: min(100%, 400px);
		height: auto;
		border-radius: 0px;
		display: block;
	}

	.about__about-me_text {
		max-width: 100%;
		min-width: 0;

		h2 {
			font-weight: 400;
			font-size: var(--font-size-h2);
			line-height: 1.1;
			word-break: break-word;
		}

		p {
			text-align: justify;
			text-indent: 80px;
			line-height: 1.15;
			font-size: var(--font-size-normal);
			overflow-wrap: anywhere;
			word-break: break-word;
			max-width: 100%;
			margin: 0 0 12px;
		}
	}
</style>
