---
import { about, localeFromPath } from "../../lib/config.js";
import { parseDescription } from "../../lib/parseDescription.js";
import Icon from "../Icon.astro";

const aboutData = about(localeFromPath(Astro.url.pathname)).about;
const descList = parseDescription(aboutData.desc);
---

<section class="about">
	<div class="wrapper">
		<div class="about__heading">
			<h2>
				{aboutData.title}
			</h2>
			<Icon size="32" name="arrow-right" />
		</div>
		<div class="avatar-wrapper">
			<img src="/aleks-about@2x.webp" alt="Aleks" class="avatar avatar--default" />
			<img src="/aleks-about-alt@2x.webp" alt="Aleks alternate" class="avatar avatar--hover" />
		</div>
		<div class="about__description">
			{descList.map((d) => <p>{d}</p>)}
		</div>
	</div>
</section>

<style>
	.wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: 60px;
	}

	.avatar-wrapper {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
	}

	.avatar {
		width: min(100%, 400px);
		height: auto;
		border-radius: 0px;
		display: block;
		transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.avatar--default {
		opacity: 1;
		transform: scale(1);
	}

	.avatar--hover {
		position: absolute;
		inset: 0;
		margin: 0 auto;
		opacity: 0;
		transform: scale(0.97);
		pointer-events: none;
	}

	.avatar-wrapper:hover .avatar--default {
		opacity: 0;
		transform: scale(1.01);
	}

	.avatar-wrapper:hover .avatar--hover {
		opacity: 1;
		transform: scale(1);
	}

	.about__heading {
		align-self: stretch;

		h2 {
			font-weight: 400;
			font-size: var(--font-size-h2);
			line-height: 1.1;
			word-break: break-word;
		}
	}

	.about__description {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		width: 100%;
		margin-top: 60px;
		text-align: justify;
		text-indent: 80px;

		@media (min-width: 768px) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		p {
			margin: 0;
			line-height: 1.15;
			font-size: var(--font-size-normal);
			overflow-wrap: anywhere;
			word-break: break-word;
		}
	}

</style>
